# Настройки AI-ассистента Websoft HCM. Скопируйте этот файл в .env рядом с
# docker-compose.yml и заполните значения. После правки — docker compose up -d.

# ----------------------------------------------------------------------------
# Ключ доступа
# ----------------------------------------------------------------------------
# Ключ доступа к бета-версии. Действует до 2026-12-31 включительно.
LICENSE_KEY=WSHAA1.eyJ2IjoxLCJsaWNlbnNlZSI6IndzX2hjbV9haV9hc3Npc3RhbnRfYmV0YS0yMDI2LjkiLCJpYXQiOjE3OTAyNTczOTksImV4cCI6MTc5ODc2MTU5OSwiY29udGFjdCI6Imh0dHBzOi8vdC5tZS9zcG9sb2xpbiJ9.6zCnZqrHqM1SfEEPbeRXP69tkfg01E_giikPuVqqVnVSnR1ZHvBb9JM8Y8SvnogtXHs44PAoMUULq-ZhgGNSAg

# ----------------------------------------------------------------------------
# Каталог WebSoftServer (обязательно)
# ----------------------------------------------------------------------------
# Путь к корню каталога WebSoftServer на машине, где запущен Docker.
# Монтируется внутрь контейнера только на чтение.
#   Windows (Docker Desktop):  C:/Program Files/WebSoft/WebSoftServer
#   Linux:                     /opt/websoft/WebSoftServer
#   macOS:                     /Users/me/WebSoftServer
#   Docker в WSL:              /mnt/c/Program Files/WebSoft/WebSoftServer
HCM_HOST_PATH=

# ----------------------------------------------------------------------------
# База данных HCM (только чтение)
# ----------------------------------------------------------------------------
# mssql или postgres
DB_TYPE=mssql
# Адрес сервера. Для именованного экземпляра MS SQL укажите host и DB_PORT
# отдельно — запись host\instance из контейнера не резолвится.
DB_SERVER=
# Порт. MS SQL по умолчанию 1433, PostgreSQL 5432. Пустое — значение драйвера.
DB_PORT=
DB_DATABASE=
# Пользователь только с правом чтения — скрипты в каталоге sql/.
DB_USER=
DB_PASSWORD=
# Шифрование соединения с MS SQL. Самоподписанный сертификат сервера
# принимается. Поставьте false только если сервер вообще без TLS.
DB_ENCRYPT=true
# Сколько миллисекунд ждать ответа базы на один запрос, который пишет модель
# (execute_sql, query_object). Затянувшийся запрос прерывается, модель видит
# ошибку таймаута. От 100 до 600000. Запросы при старте сервера не ограничены.
SQL_EXEC_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------
# Создание и изменение карточек в HCM (необязательно)
# ----------------------------------------------------------------------------
# Ассистент создаёт и меняет карточек (агенты, курсы, мероприятия…) через
# Open API платформы. Если не включено, ассистент только читает.
# Настройка в HCM по шагам — docs/11-write-api.md.
# Адрес сайта HCM, как его видит контейнер (localhost внутри контейнера — это
# сам контейнер): http://hcm-server или http://192.168.1.10:8080
HCM_API_URL=
# APP ID внешнего приложения API и логин/пароль его удостоверения.
HCM_API_APP_ID=
HCM_API_LOGIN=
HCM_API_PASSWORD=

# ----------------------------------------------------------------------------
# Доступ к серверу
# ----------------------------------------------------------------------------
# Токен, который MCP-клиенты передают в заголовке Authorization: Bearer <токен>.
# Обязателен: с пустым значением сервер не запустится, т.к. к нему может
# обратиться любой, кто знает сервер. Сгенерировать:
#   PowerShell: [guid]::NewGuid().ToString('N')
#   bash:       openssl rand -hex 16
MCP_AUTH_TOKEN=

# Порты на машине с Docker (внутри контейнера всегда 3000 и 3001).
ASSISTANT_HTTP_PORT=3100
ASSISTANT_SSE_PORT=3101

# ----------------------------------------------------------------------------
# Телеметрия и дашборд
# ----------------------------------------------------------------------------
# Нужны для обратной связи: дашборд показывает статистику, страница
# «Выгрузка телеметрии» собирает архив, который вы присылаете в issues.
# Персональные данные маскируются при записи, наружу сервер ничего не шлёт.
MCP_TELEMETRY_ENABLED=true
DASHBOARD_ENABLED=true

# ----------------------------------------------------------------------------
# Поиск и логи
# ----------------------------------------------------------------------------
# true включает гибридный поиск: качество выше, но при первом старте сервер
# несколько минут считает векторы в фоне и скачивает модель (~120 МБ).
SEARCH_HYBRID_ENABLED=false
# Если HTTPS перехватывает антивирус (например, Kaspersky) или прокси, модель
# не скачается: положите корневой сертификат перехватчика в папку certs
# рядом с docker-compose.yml под именем ca.pem и раскомментируйте строку.
# Как выгрузить сертификат — docs/09-troubleshooting.md.
# NODE_EXTRA_CA_CERTS=/app/certs/ca.pem
# error | warn | info | debug | verbose
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Образ
# ----------------------------------------------------------------------------
# Тег образа: latest — последний выпуск, либо точная версия
# (например 2.5.2-beta.1540), чтобы обновляться.
ASSISTANT_TAG=latest
# Запасной реестр, если ghcr.io недоступен:
# ASSISTANT_IMAGE=docker.io/spololin/ws_hcm_ai_assistant

# ----------------------------------------------------------------------------
# Каталог WebSoftServer на сетевой шаре (см. конец файла docker-compose.yml)
# ----------------------------------------------------------------------------
# Сервер шары: имя или IP. Если docker compose up падает на разрешении имени,
# укажите IP.
# HCM_SHARE_HOST=192.168.1.10
# Имя шары, можно с подкаталогами: \\srv\hcm\prod\WebSoftServer → hcm/prod/WebSoftServer.
# Административную шару со знаком $ пишите в одинарных кавычках: 'D$/Websoft/WebSoftServer'.
# HCM_SHARE_NAME=WebSoftServer
# Логин без домена. Домен (часть до обратного слеша в выводе whoami) — отдельно;
# для локальной учётки сервера строку с доменом не заполняйте.
# Пароль не должен содержать запятую и кавычки.
# HCM_SHARE_USER=
# HCM_SHARE_PASSWORD=
# HCM_SHARE_DOMAIN=
